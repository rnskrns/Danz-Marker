{
"update_url": "https://clients2.google.com/service/update2/crx",

  "name": "단이봤",
  "description": "등록한 네이버 카페에서만, 카페 주인이 댓글 또는 좋아요를 남긴 글을 이모지 또는 제목 회색으로 표시합니다.",
  "version": "1.4.1",
  "manifest_version": 3,
  "host_permissions": ["https://cafe.naver.com/*", "https://apis.naver.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cafe.naver.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "script.js"
      ],
      "matches": [
        "https://cafe.naver.com/*",
        "https://apis.naver.com/*"
      ]
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "tabs", "webRequest"],
  "action": {
    "default_popup": "/popup/popup.html",
    "default_icon": {
      "16": "/images/icon16.png",
      "32": "/images/icon32.png",
      "48": "/images/icon48.png",
      "64": "/images/icon64.png",
      "128": "/images/icon128.png"
    }
  },
  "icons": {
    "16": "/images/icon16.png",
    "32": "/images/icon32.png",
    "48": "/images/icon48.png",
    "64": "/images/icon64.png",
    "128": "/images/icon128.png"
  }
}
